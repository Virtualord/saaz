{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./web/src/*"
      ]
    },
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "web/src/**/*.ts",
    "web/src/**/*.tsx",
    "tests/**/*.ts",
    "*.ts"
  ]
}
