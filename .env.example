# Saaz — all optional. The app runs fully offline with zero configuration.
PORT=8080
NODE_ENV=development

# Where model weights are cached (downloaded once, then never again).
SAAZ_MODEL_DIR=./data/models

# Observability. The in-process trace store and GET /api/traces work with no
# configuration at all, which is what keeps the offline claim testable.

# Emit one JSON line per finished span (noisy; for triage).
SAAZ_EMIT_SPANS=false

# Traces retained in the ring buffer.
SAAZ_TRACE_BUFFER=60

# Optional. Forward spans to Sentry when a DSN is present. Without it, tracing
# stays entirely in-process and nothing leaves the machine.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=1.0

# Server-side cap on upload size in megabytes.
SAAZ_MAX_UPLOAD_MB=200
