# npm 11 blocks lifecycle scripts by default. That is the right default, but it
# breaks two dependencies here:
#
#   better-sqlite3  — its install script compiles a native module. Without it,
#                     npm falls back to node-gyp, which needs Python and fails
#                     in a slim image. The shipped prebuild for linux-x64 is used
#                     at runtime regardless (see Dockerfile deps stage).
#   onnxruntime-node — its postinstall fetches the prebuilt native library.
#
# NOTE: `allow-scripts` is not a recognised npm config key (npm warns about it),
# so this file cannot grant the scripts itself. The Dockerfile installs build
# tooling in every stage that runs `npm ci`, which is the actual fix. Kept here
# so the intent is documented and reproducible if the policy ever changes.
fund=false
audit=false